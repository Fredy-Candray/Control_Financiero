<resources>
    <style name="CofiTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00A573</item>
        <item name="android:statusBarColor">@color/cofi_navy</item>
        <item name="android:navigationBarColor">@color/cofi_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/cofi_navy</item>
        <item name="android:windowSplashScreenBackground">@color/cofi_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/cofi_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">250</item>
    </style>
</resources>
