# Supply through the process/service environment; Spring does not auto-load this file.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Base64 of 32 cryptographically random bytes. Persist the same value across restarts.
GMAIL_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://localhost:8081/api/gmail-bac/callback
GMAIL_FRONTEND_URL=http://localhost:4200/cuentas
GMAIL_POLL_MS=60000
# PAY transfers only; set a new cutoff when migrating verified current balances.
PAY_USER_ID=
PAY_EXTENDED=false
PAY_OWNER_NAME=
GMAIL_EVENTS_SINCE=
PAY_IMPORT_SINCE=
PAY_DESTINATION_LAST_FOUR=
PAY_ORIGIN_NAME=Pay
PAY_DESTINATION_NAME=Tarjeta débito
# For server deployment also set:
# SPRING_PROFILES_ACTIVE=server
# DB_URL=jdbc:sqlserver://DATABASE_HOST:1433;databaseName=control_financiero;encrypt=true;trustServerCertificate=false
# DB_USERNAME=
# DB_PASSWORD=
# APP_CORS_ORIGINS=https://YOUR_HOST
# GMAIL_REDIRECT_URI=https://YOUR_HOST/api/gmail-bac/callback
# GMAIL_FRONTEND_URL=https://YOUR_HOST/cuentas
